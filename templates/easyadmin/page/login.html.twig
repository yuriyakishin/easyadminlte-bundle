{#
    AdminLTE 4 login page (main.login-box > .card > .login-card-body), see AdminLTE's examples/login.html.
    Accepts the same variables as EasyAdmin's page/login.html.twig (page_title, error, last_username,
    csrf_token_intention, *_label, *_parameter, remember_me_*, forgot_password_*...) and keeps its
    blocks (header_logo, login_form_wrapper, login_form_credentials_wrapper, login_form_footer).

    Like the original, it extends the dashboard layout when rendered inside an EasyAdmin dashboard and
    EasyAdmin's minimal login layout otherwise (e.g. a login route outside the dashboard).
#}
{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Provider\AdminContextProvider #}
{% set ea = ea() %}
{% extends null != ea ? ea.templatePath('layout') : '@EasyAdmin/page/login_minimal.html.twig' %}
{% trans_default_domain null != ea ? ea.i18n.translationDomain : (translation_domain is defined ? translation_domain ?? 'messages') %}

{# used inside a dashboard (this bundle's layout.html.twig) #}
{% block adminlte_body_class 'login-page bg-body-secondary' %}
{# login_minimal.html.twig has no "adminlte_body_class" block, so the AdminLTE classes go here #}
{% block body_class 'page-login' ~ (null == ea ? ' login-page bg-body-secondary') %}
{% block page_title %}{{ page_title is defined ? page_title|raw : (null != ea ? ea.dashboardTitle|raw : '') }}{% endblock %}

{% block head_favicon %}
    {% if favicon_path|default(false) %}
        <link rel="shortcut icon" href="{{ favicon_path }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    {# inside a dashboard the AdminLTE CSS is added by AdminLTERouterSubscriber; outside of it there's no AdminContext #}
    {% if null == ea %}
        <link rel="stylesheet" href="{{ asset('css/easyadminlte.css', 'easyadminlte') }}">
    {% endif %}
{% endblock %}

{% block wrapper_wrapper %}
    {% set page_title = block('page_title') %}
    {% set _username_label = username_label is defined ? username_label|trans : 'login_page.username'|trans({}, 'EasyAdminBundle') %}
    {% set _password_label = password_label is defined ? password_label|trans : 'login_page.password'|trans({}, 'EasyAdminBundle') %}
    {% set _forgot_password_label = forgot_password_label is defined ? forgot_password_label|trans : 'login_page.forgot_password'|trans({}, 'EasyAdminBundle') %}
    {% set _remember_me_label = remember_me_label is defined ? remember_me_label|trans : 'login_page.remember_me'|trans({}, 'EasyAdminBundle') %}
    {% set _sign_in_label = sign_in_label is defined ? sign_in_label|trans : 'login_page.sign_in'|trans({}, 'EasyAdminBundle') %}

    <main class="login-box">
        <div class="login-logo">
            {% block header_logo %}
                {% if page_title %}
                    {% if null != ea %}
                        <a title="{{ page_title|striptags }}" href="{{ path(ea.dashboardRouteName) }}">{{ page_title|raw }}</a>
                    {% else %}
                        {{ page_title|raw }}
                    {% endif %}
                {% endif %}
            {% endblock header_logo %}
        </div>

        {{ include('@EasyAdmin/flash_messages.html.twig') }}

        <div class="card">
            <div class="card-body login-card-body">
                {% if error|default(false) %}
                    <div class="alert alert-danger mb-3" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% block login_form_wrapper %}
                    <form method="post" action="{{ action|default('') }}">
                        {% if csrf_token_intention|default(false) %}
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_token_intention) }}">
                        {% endif %}

                        <input type="hidden" name="{{ target_path_parameter|default('_target_path') }}" value="{{ target_path|default(null != ea ? path(ea.dashboardRouteName) : '/') }}" />

                        {% block login_form_credentials_wrapper %}
                            <label class="visually-hidden" for="username">{{ _username_label }}</label>
                            <div class="input-group mb-3">
                                <input type="text" id="username" name="{{ username_parameter|default('_username') }}" class="form-control" placeholder="{{ _username_label }}" value="{{ last_username|default('') }}" required autofocus autocomplete="username">
                                <div class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></div>
                            </div>

                            <label class="visually-hidden" for="password">{{ _password_label }}</label>
                            <div class="input-group mb-3">
                                <input type="password" id="password" name="{{ password_parameter|default('_password') }}" class="form-control" placeholder="{{ _password_label }}" required autocomplete="current-password">
                                <div class="input-group-text"><i class="bi bi-lock-fill" aria-hidden="true"></i></div>
                            </div>
                        {% endblock login_form_credentials_wrapper %}

                        <div class="row align-items-center">
                            <div class="col-7">
                                {% if remember_me_enabled|default(false) %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="remember_me" name="{{ remember_me_parameter|default('_remember_me') }}" {{ remember_me_checked|default(false) ? 'checked' }}>
                                        <label class="form-check-label" for="remember_me">{{ _remember_me_label }}</label>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="col-5">
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">{{ _sign_in_label }}</button>
                                </div>
                            </div>
                        </div>
                    </form>

                    {% if forgot_password_enabled|default(false) %}
                        <p class="mb-0 mt-3">
                            <a href="{{ forgot_password_path|default('#') }}">{{ _forgot_password_label }}</a>
                        </p>
                    {% endif %}

                    {% block login_form_footer %}{% endblock login_form_footer %}

                    {# disables the submit button on submit to prevent double submissions #}
                    {% guard function csp_nonce %}
                        <script src="{{ asset('login.js', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}" nonce="{{ csp_nonce('script') }}"></script>
                    {% else %}
                        <script src="{{ asset('login.js', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}"></script>
                    {% endguard %}
                {% endblock login_form_wrapper %}
            </div>
        </div>
    </main>
{% endblock %}
