{% extends '@!EasyAdmin/layout.html.twig' %}

{#
    The <head> is inherited from EasyAdmin as-is. The <body> is rebuilt with the AdminLTE 4
    structure (.app-wrapper > .app-header / .app-sidebar / .app-main / .app-footer), keeping the
    EasyAdmin block names so CRUD pages and application overrides keep working.

    AdminLTE classes live in their own "adminlte_body_class" block (not in "body_class") because
    CRUD pages override "body_class" (e.g. crud/index.html.twig) and would remove them.
#}
{% block body %}
    <body {% block body_attr %}{% endblock %}
        id="{% block body_id %}{% endblock %}"
        class="ea {% block adminlte_body_class %}layout-fixed sidebar-expand-lg bg-body-tertiary{% endblock %} {% block body_class %}{% endblock %}"
        data-ea-content-width="{{ ea.crud.contentWidth ?? ea.dashboardContentWidth ?? 'normal' }}"
        data-ea-sidebar-width="{{ ea.crud.sidebarWidth ?? ea.dashboardSidebarWidth ?? 'normal' }}"
        data-ea-dark-scheme-is-enabled="{{ ea.dashboardHasDarkModeEnabled ? 'true' : 'false' }}"
        data-ea-default-color-scheme="{{ ea.dashboardDefaultColorScheme }}"
        data-ea-icon-set="{{ ea.assets.iconSet }}"
        data-ea-icon-prefix="{{ ea.assets.defaultIconPrefix }}"
    >
    {{ block('javascript_page_layout') }}
    {{ block('javascript_page_color_scheme') }}

    {% block wrapper_wrapper %}
        {% set user_menu_avatar %}
            {% if null == ea.userMenu.avatarUrl %}
                <i class="bi bi-person-circle user-image" aria-hidden="true"></i>
            {% else %}
                <img class="user-image rounded-circle shadow" src="{{ ea.userMenu.avatarUrl }}" alt="" />
            {% endif %}
        {% endset %}

        {% set impersonator_permission = constant('Symfony\\Component\\Security\\Core\\Authorization\\Voter\\AuthenticatedVoter::IS_IMPERSONATOR') is defined ? 'IS_IMPERSONATOR' : 'ROLE_PREVIOUS_ADMIN' %}

        <div class="app-wrapper">
            {% block wrapper %}
                <nav class="app-header navbar navbar-expand bg-body">
                    <div class="container-fluid">
                        {% block header %}
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle navigation">
                                        <i class="bi bi-list" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>

                            {% block content_top_header %}
                                {% block search_wrapper %}
                                    {% set has_search = ea.crud is not null and ea.crud.isSearchEnabled %}
                                    <div class="content-search ms-3">
                                        {% if has_search %}
                                            {% block search %}
                                                {% set crudController = ea.request.attributes.get('crudControllerFqcn') %}
                                                {% set formActionUrl = ea_url().setController(crudController).setAction('index').set('page', 1) %}
                                                <form class="form-action-search navbar-search" method="get" action="{{ formActionUrl }}" role="search">
                                                    {% block search_form %}
                                                        {% block search_form_filters %}
                                                            {# re-applies the current filters on searches (same logic as EasyAdmin's layout) #}
                                                            {% for field, fieldValue in ea.search.appliedFilters %}
                                                                {% if fieldValue is iterable %}
                                                                    {% for key, value in fieldValue %}
                                                                        {% if value is iterable %}
                                                                            {% for index, iterValue in value %}
                                                                                {% if iterValue is iterable %}
                                                                                    {% for subIndex, subIterValue in iterValue %}
                                                                                        <input type="hidden" name="filters[{{ field }}][{{ key }}][{{ index }}][{{ subIndex }}]" value="{{ subIterValue }}">
                                                                                    {% endfor %}
                                                                                {% else %}
                                                                                    <input type="hidden" name="filters[{{ field }}][{{ key }}][{{ index }}]" value="{{ iterValue }}">
                                                                                {% endif %}
                                                                            {% endfor %}
                                                                        {% else %}
                                                                            <input type="hidden" name="filters[{{ field }}][{{ key }}]" value="{{ value }}">
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                {% else %}
                                                                    <input type="hidden" name="filters[{{ field }}]" value="{{ fieldValue }}">
                                                                {% endif %}
                                                            {% endfor %}
                                                        {% endblock search_form_filters %}

                                                        {% block search_form_query_parameters %}
                                                            {# GET forms drop the action's query string, so custom query parameters are re-added as hidden fields #}
                                                            {% for paramName, paramValue in app.request.query.all|filter((value, key) => key not in ['query', 'page', 'filters'])|ea_flatten_array %}
                                                                <input type="hidden" name="{{ paramName }}" value="{{ paramValue }}">
                                                            {% endfor %}
                                                        {% endblock search_form_query_parameters %}

                                                        <label for="navbar-search-input" class="visually-hidden">{{ t('action.search', ea.i18n.translationParameters, 'EasyAdminBundle')|trans }}</label>
                                                        <div class="navbar-search-field">
                                                            <input id="navbar-search-input" class="form-control" type="search" name="query" value="{{ app.request.query.get('query') ?? '' }}" placeholder="{{ t('action.search', ea.i18n.translationParameters, 'EasyAdminBundle')|trans }}…" spellcheck="false" autocorrect="off" autocomplete="off"{% if ea.crud.currentAction == 'index' and ea.crud.autofocusSearch == true %} autofocus="autofocus"{% endif %}>
                                                            {% if app.request.query.get('query') %}
                                                                {% set search_reset_url = ea_url().unset('query').unset('page').setController(crudController).setAction('index') %}
                                                                <a href="{{ search_reset_url }}" class="navbar-search-submit content-search-reset" aria-label="Reset search">
                                                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                                </a>
                                                            {% else %}
                                                                <button class="navbar-search-submit" type="submit" aria-label="{{ t('action.search', ea.i18n.translationParameters, 'EasyAdminBundle')|trans }}">
                                                                    <i class="bi bi-search" aria-hidden="true"></i>
                                                                </button>
                                                            {% endif %}
                                                        </div>
                                                    {% endblock search_form %}
                                                </form>
                                            {% endblock search %}
                                        {% endif %}
                                    </div>
                                {% endblock search_wrapper %}

                                <ul class="navbar-nav ms-auto">
                                    {% block settings_dropdown_wrapper %}
                                        {% if ea.dashboardLocales or ea.dashboardHasDarkModeEnabled %}
                                            {% if ea.dashboardHasDarkModeEnabled %}
                                                {# AdminLTE-style light/dark toggle; easyadminlte.js forwards the click to the matching
                                                   appearance item below, so EasyAdmin keeps handling (and persisting) the color scheme #}
                                                <li class="nav-item">
                                                    <a class="nav-link" href="#" role="button" data-easyadminlte-color-scheme-toggle aria-label="{{ 'settings.appearance.label'|trans(domain: 'EasyAdminBundle') }}">
                                                        <i class="bi bi-moon color-scheme-icon-light" aria-hidden="true"></i>
                                                        <i class="bi bi-sun color-scheme-icon-dark" aria-hidden="true"></i>
                                                    </a>
                                                </li>
                                            {% endif %}

                                            {# "dropdown-settings" and "a.dropdown-appearance-item[data-ea-color-scheme]" are used by EasyAdmin's
                                               page-color-scheme.js, so the dropdown is always rendered (but only shown when there are locales) #}
                                            <li class="nav-item dropdown dropdown-settings {{ not ea.dashboardLocales ? 'd-none' }}">
                                                <a class="nav-link" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false" aria-label="Settings">
                                                    <i class="bi bi-gear" aria-hidden="true"></i>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    {% if ea.dashboardLocales %}
                                                        <li><h6 class="dropdown-header">{{ 'settings.locale'|trans(domain: 'EasyAdminBundle') }}</h6></li>
                                                        {% for localeDto in ea.dashboardLocales %}
                                                            {% set url = ea_url(app.current_route_parameters)
                                                                .set('_locale', localeDto.locale)
                                                                .set('entityId', app.request.attributes.get('entityId')) %}
                                                            <li>
                                                                <a class="dropdown-item {{ app.request.locale == localeDto.locale ? 'active' }}" href="{{ url.generateUrl() }}">
                                                                    {% if localeDto.icon %}<twig:ea:Icon name="{{ localeDto.icon }}" class="me-2" />{% endif %}
                                                                    {{ localeDto.name }}
                                                                </a>
                                                            </li>
                                                        {% endfor %}
                                                    {% endif %}

                                                    {% if ea.dashboardHasDarkModeEnabled %}
                                                        {% if ea.dashboardLocales %}<li><hr class="dropdown-divider"></li>{% endif %}
                                                        <li><h6 class="dropdown-header">{{ 'settings.appearance.label'|trans(domain: 'EasyAdminBundle') }}</h6></li>
                                                        {% for scheme, icon in {light: 'bi-sun', dark: 'bi-moon', auto: 'bi-circle-half'} %}
                                                            <li>
                                                                <a class="dropdown-item dropdown-appearance-item" href="#" data-ea-color-scheme="{{ scheme }}">
                                                                    <i class="bi {{ icon }} me-2" aria-hidden="true"></i>
                                                                    {{ ('settings.appearance.' ~ scheme)|trans(domain: 'EasyAdminBundle') }}
                                                                </a>
                                                            </li>
                                                        {% endfor %}
                                                    {% endif %}
                                                </ul>
                                            </li>
                                        {% endif %}
                                    {% endblock settings_dropdown_wrapper %}

                                    {% block header_custom_menu_wrapper %}
                                        {% block header_custom_menu %}
                                            <li class="nav-item dropdown user-menu {{ is_granted(impersonator_permission) ? 'user-is-impersonated' }}">
                                                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                    {{ user_menu_avatar }}
                                                    {% if ea.userMenu.isNameDisplayed %}
                                                        <span class="d-none d-md-inline">{{ ea.userMenu.name }}</span>
                                                    {% endif %}
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                                                    <li class="user-header text-bg-primary">
                                                        {{ user_menu_avatar }}
                                                        <p>
                                                            {{ ea.user is null ? 'user.anonymous'|trans(domain: 'EasyAdminBundle') : ea.userMenu.name }}
                                                            <small>{{ 'user.logged_in_as'|trans(domain: 'EasyAdminBundle') }}</small>
                                                        </p>
                                                    </li>
                                                    {% block user_menu %}
                                                        {% for item in ea.userMenu.items %}
                                                            {% if item.isMenuSection %}
                                                                <li><hr class="dropdown-divider"></li>
                                                                {% if item.label is not empty %}
                                                                    <li><h6 class="dropdown-header {{ item.cssClass }}">{{ item.label|trans }}</h6></li>
                                                                {% endif %}
                                                            {% else %}
                                                                {% if loop.first %}<li><hr class="dropdown-divider"></li>{% endif %}
                                                                <li>
                                                                    <a class="dropdown-item user-action {{ item.cssClass }}" href="{{ item.linkUrl }}" referrerpolicy="origin-when-cross-origin"
                                                                        {%- if item.linkTarget %} target="{{ item.linkTarget }}"{% endif %}
                                                                        {%- if item.linkRel %} rel="{{ item.linkRel }}"{% endif %}
                                                                        {%- for name, value in item.htmlAttributes %} {{ name }}="{{ value|e('html') }}"{% endfor %}>
                                                                        {% if item.icon %}<twig:ea:Icon name="{{ item.icon }}" class="me-2" />{% endif %}
                                                                        {{ item.label|trans }}
                                                                    </a>
                                                                </li>
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% endblock user_menu %}
                                                </ul>
                                            </li>
                                        {% endblock header_custom_menu %}
                                    {% endblock header_custom_menu_wrapper %}
                                </ul>
                            {% endblock content_top_header %}
                        {% endblock header %}
                    </div>
                </nav>

                <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
                    {% block sidebar %}
                        <div class="sidebar-brand">
                            {% block header_logo %}
                                <a class="brand-link" title="{{ ea.dashboardTitle|striptags }}" href="{{ path(ea.dashboardRouteName) }}">
                                    {% block sidebar_brand_image %}
                                        <img src="{{ asset('img/AdminLTELogo.png', 'easyadminlte') }}" alt="" class="brand-image opacity-75 shadow">
                                    {% endblock sidebar_brand_image %}
                                    <span class="brand-text fw-light">{{ ea.dashboardTitle|raw }}</span>
                                </a>
                            {% endblock header_logo %}
                        </div>

                        <div class="sidebar-wrapper">
                            {# AdminLTE markup for the menu (sidebar-menu / nav-item), see menu.html.twig #}
                            {% block main_menu_wrapper %}
                                {{ include(ea.templatePath('main_menu')) }}
                            {% endblock main_menu_wrapper %}

                            {% block sidebar_footer %}{% endblock %}
                        </div>
                    {% endblock sidebar %}
                </aside>

                {% block main_content_wrapper %}
                    {# "content", "content-header-title > .title", ".global-actions" and ".batch-actions" are used by
                       EasyAdmin's app.js to swap the title/global actions for batch actions when table rows are selected #}
                    <main class="app-main content">
                        {% block content %}
                            {# like AdminLTE's form cards, the new/edit form buttons go to the card footer instead of the
                               page header (they're bound to the form with form="...", so they work outside of it) #}
                            {% set form_actions_in_card_footer = ea.crud is not null and ea.crud.currentPage in ['new', 'edit'] %}
                            {% block content_header_wrapper %}
                                {% set crud_help_message = ea.crud.helpMessage ?? null %}
                                {% set has_help_message = crud_help_message is ea_is_not_empty %}
                                <div class="app-content-header">
                                    <div class="container-fluid">
                                        {% block content_header %}
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <div class="content-header-title flex-grow-1">
                                                    <h3 class="title mb-0">
                                                        {% block content_title %}{% endblock %}

                                                        {% block content_help %}
                                                            {% if has_help_message %}
                                                                <a tabindex="0" class="content-header-help text-body-secondary fs-6 align-middle" data-bs-toggle="popover" data-bs-custom-class="ea-content-help-popover" data-bs-animation="true" data-bs-html="true" data-bs-placement="bottom" data-bs-trigger="focus" data-bs-content="{{ ea.crud.helpMessage|trans|e('html') }}">
                                                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                                                </a>
                                                            {% endif %}
                                                        {% endblock content_help %}
                                                    </h3>
                                                </div>

                                                {% if not form_actions_in_card_footer %}
                                                    {% block page_actions_wrapper %}
                                                        <div class="page-actions d-flex flex-wrap gap-2">{% block page_actions %}{% endblock %}</div>
                                                    {% endblock page_actions_wrapper %}
                                                {% endif %}
                                            </div>
                                        {% endblock content_header %}
                                    </div>
                                </div>
                            {% endblock content_header_wrapper %}

                            <div class="app-content">
                                <div class="container-fluid">
                                    {% block flash_messages %}
                                        {{ include(ea.templatePath('flash_messages')) }}
                                    {% endblock flash_messages %}

                                    {# CRUD pages render inside an AdminLTE card (the index table edge to edge);
                                       other pages (e.g. the dashboard) lay out their own content #}
                                    {# not for EasyAdmin's error page (exception.html.twig), which is rendered in this layout too #}
                                    {% set main_in_card = ea.crud is not null and exception is not defined %}
                                    <section id="main" class="content-body {{ main_in_card ? 'card mb-4' }}">
                                        {% if main_in_card %}
                                            {% block main_card_header %}
                                                {% set is_index_page = 'index' == ea.crud.currentPage %}
                                                {% set entity_instance = is_index_page ? null : ea.entity.instance ?? null %}
                                                {% set card_title = is_index_page
                                                    ? ea.crud.entityLabelInPlural(entity_instance, ea.crud.currentPage)
                                                    : ea.crud.entityLabelInSingular(entity_instance, ea.crud.currentPage) %}
                                                {% if card_title is not empty %}
                                                    <div class="card-header">
                                                        <h3 class="card-title">{{ card_title|trans({}, ea.i18n.translationDomain)|raw }}</h3>
                                                    </div>
                                                {% endif %}
                                            {% endblock main_card_header %}
                                            <div class="card-body {{ 'index' == ea.crud.currentPage ? 'p-0' }}">
                                        {% endif %}
                                        {% block main %}{% endblock %}
                                        {% if main_in_card %}
                                            </div>
                                            {% if form_actions_in_card_footer %}
                                                <div class="card-footer page-actions d-flex flex-wrap justify-content-end gap-2">{{ block('page_actions') }}</div>
                                            {% endif %}
                                        {% endif %}
                                    </section>

                                    {# per-page footer below the main content (same place as in EasyAdmin) #}
                                    {% block content_footer_wrapper %}
                                        {% if block('content_footer') is not empty %}
                                            <section class="content-footer">
                                                {% block content_footer %}{% endblock %}
                                            </section>
                                        {% endif %}
                                    {% endblock content_footer_wrapper %}
                                </div>
                            </div>
                        {% endblock content %}
                    </main>
                {% endblock main_content_wrapper %}

                {% block app_footer %}
                    <footer class="app-footer">
                        <div class="float-end d-none d-sm-inline">{% block app_footer_end %}{% endblock app_footer_end %}</div>
                        {% block app_footer_start %}
                            <strong>&copy; {{ 'now'|date('Y') }} {{ ea.dashboardTitle|striptags }}</strong>
                        {% endblock app_footer_start %}
                    </footer>
                {% endblock app_footer %}
            {% endblock wrapper %}
        </div>
    {% endblock wrapper_wrapper %}

    {{ block('body_javascript') }}
    {{ block('configured_body_contents') }}
    </body>
{% endblock body %}
